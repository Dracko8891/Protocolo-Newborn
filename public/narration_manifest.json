{
  "versao": "1.0.0",
  "idioma": "pt-BR",
  "personagem": "Arthur Vance",
  "availableBaseAudio": [
    "audio/narration/base/intro_flashback_base.ogg",
    "audio/narration/base/title_prologue.ogg"
  ],
  "cues": [
    {
      "id": "title_prologue",
      "scope": "base",
      "emotion": "medo",
      "priority": 2,
      "exaggeration": 0.68,
      "cfgWeight": 0.48,
      "cooldownMs": 20000,
      "durationHintMs": 6200,
      "audioPath": "audio/narration/base/title_prologue.ogg",
      "text": "Vanguard-7... O alarme não para. Tem alguma coisa no fundo desse corredor... esperando eu me mexer."
    },
    {
      "id": "intro_flashback_base",
      "scope": "base",
      "emotion": "tenso",
      "priority": 3,
      "exaggeration": 0.72,
      "cfgWeight": 0.45,
      "cooldownMs": 6000,
      "durationHintMs": 4800,
      "audioPath": "audio/narration/base/intro_flashback_base.ogg",
      "text": "Respira, Arthur... Fica agachado. Se essa coisa ouvir seus passos no escuro, acabou."
    },
    {
      "id": "chapter_01_intro",
      "scope": "chapter",
      "chapterId": 1,
      "emotion": "medo",
      "priority": 3,
      "exaggeration": 0.74,
      "cfgWeight": 0.45,
      "cooldownMs": 5000,
      "durationHintMs": 5600,
      "audioPath": "audio/narration/chapter_01_intro.ogg",
      "text": "Ala Médica... Cheiro de ferro e sangue seco. O vidro rachou... precisa ter um crachá de acesso por aqui."
    },
    {
      "id": "chapter_01_victory",
      "scope": "chapter",
      "chapterId": 1,
      "emotion": "ofegante",
      "priority": 4,
      "exaggeration": 0.82,
      "cfgWeight": 0.42,
      "cooldownMs": 3000,
      "durationHintMs": 5200,
      "audioPath": "audio/narration/chapter_01_victory.ogg",
      "text": "A comporta cedeu... Consegui! Mas... o que eu fiz? A energia acabou de abrir os dutos pro próximo andar..."
    },
    {
      "id": "chapter_02_intro",
      "scope": "chapter",
      "chapterId": 2,
      "emotion": "tenso",
      "priority": 3,
      "exaggeration": 0.66,
      "cfgWeight": 0.46,
      "cooldownMs": 5000,
      "durationHintMs": 5400,
      "audioPath": "audio/narration/chapter_02_intro.ogg",
      "text": "Átrio Frio... Meu hálito tá congelando. O frio devia ter parado ele... mas já escuto cliques lá na frente."
    },
    {
      "id": "chapter_02_victory",
      "scope": "chapter",
      "chapterId": 2,
      "emotion": "ofegante",
      "priority": 4,
      "exaggeration": 0.8,
      "cfgWeight": 0.42,
      "cooldownMs": 3000,
      "durationHintMs": 5000,
      "audioPath": "audio/narration/chapter_02_victory.ogg",
      "text": "Saí desse freezer... Os Alojamentos ficam logo ali. Rápido... tem passos pesados descendo atrás de mim."
    },
    {
      "id": "chapter_03_intro",
      "scope": "chapter",
      "chapterId": 3,
      "emotion": "medo",
      "priority": 3,
      "exaggeration": 0.75,
      "cfgWeight": 0.45,
      "cooldownMs": 5000,
      "durationHintMs": 5400,
      "audioPath": "audio/narration/chapter_03_intro.ogg",
      "text": "Os dormitórios... Ninguém conseguiu fugir. Cada porta entreaberta parece estar me observando."
    },
    {
      "id": "chapter_03_victory",
      "scope": "chapter",
      "chapterId": 3,
      "emotion": "ofegante",
      "priority": 4,
      "exaggeration": 0.8,
      "cfgWeight": 0.42,
      "cooldownMs": 3000,
      "durationHintMs": 5000,
      "audioPath": "audio/narration/chapter_03_victory.ogg",
      "text": "Passei... Mas o único caminho agora desce pros Bio-Tanques. Eu não quero ver o que sobrou lá embaixo."
    },
    {
      "id": "chapter_04_intro",
      "scope": "chapter",
      "chapterId": 4,
      "emotion": "medo",
      "priority": 3,
      "exaggeration": 0.78,
      "cfgWeight": 0.44,
      "cooldownMs": 5000,
      "durationHintMs": 5600,
      "audioPath": "audio/narration/chapter_04_intro.ogg",
      "text": "Câmara Zero... Meu Deus, esses tanques estilhaçados... Foi aqui que criaram o Newborn. Ele conhece cada curva."
    },
    {
      "id": "chapter_04_victory",
      "scope": "chapter",
      "chapterId": 4,
      "emotion": "ofegante",
      "priority": 4,
      "exaggeration": 0.84,
      "cfgWeight": 0.4,
      "cooldownMs": 3000,
      "durationHintMs": 5000,
      "audioPath": "audio/narration/chapter_04_victory.ogg",
      "text": "Escapei daqueles vidros... A pressão das válvulas ecoou no prédio todo. Ele sabe que tô indo pra Engenharia."
    },
    {
      "id": "chapter_05_intro",
      "scope": "chapter",
      "chapterId": 5,
      "emotion": "tenso",
      "priority": 3,
      "exaggeration": 0.72,
      "cfgWeight": 0.45,
      "cooldownMs": 5000,
      "durationHintMs": 5400,
      "audioPath": "audio/narration/chapter_05_intro.ogg",
      "text": "Escuro demais... Só o pulso azul do reator no meio. Se o núcleo apagar, a gente nunca mais sai desse buraco."
    },
    {
      "id": "chapter_05_victory",
      "scope": "chapter",
      "chapterId": 5,
      "emotion": "ofegante",
      "priority": 4,
      "exaggeration": 0.82,
      "cfgWeight": 0.42,
      "cooldownMs": 3000,
      "durationHintMs": 5000,
      "audioPath": "audio/narration/chapter_05_victory.ogg",
      "text": "O núcleo segurou! O elevador pro Bloco Ômega destravou... Só mais um setor antes do hangar."
    },
    {
      "id": "chapter_06_intro",
      "scope": "chapter",
      "chapterId": 6,
      "emotion": "medo",
      "priority": 3,
      "exaggeration": 0.78,
      "cfgWeight": 0.44,
      "cooldownMs": 5000,
      "durationHintMs": 5600,
      "audioPath": "audio/narration/chapter_06_intro.ogg",
      "text": "Titânio negro... Chicanas cegas em zigue-zague. Não dá pra enxergar depois da curva. Escuta primeiro, Arthur..."
    },
    {
      "id": "chapter_06_victory",
      "scope": "chapter",
      "chapterId": 6,
      "emotion": "ofegante",
      "priority": 4,
      "exaggeration": 0.86,
      "cfgWeight": 0.4,
      "cooldownMs": 3000,
      "durationHintMs": 5000,
      "audioPath": "audio/narration/chapter_06_victory.ogg",
      "text": "Rompemos o Bloco Ômega! Falta só uma porta... O Hangar Final tá logo depois dessa comporta."
    },
    {
      "id": "chapter_07_intro",
      "scope": "chapter",
      "chapterId": 7,
      "emotion": "ofegante",
      "priority": 3,
      "exaggeration": 0.82,
      "cfgWeight": 0.42,
      "cooldownMs": 5000,
      "durationHintMs": 5600,
      "audioPath": "audio/narration/chapter_07_intro.ogg",
      "text": "O Hangar! Dá pra sentir o vento gelado da nevasca lá fora... Aguenta firme, só falta abrir o portão de carga!"
    },
    {
      "id": "chapter_07_victory",
      "scope": "chapter",
      "chapterId": 7,
      "emotion": "ofegante",
      "priority": 5,
      "exaggeration": 0.9,
      "cfgWeight": 0.38,
      "cooldownMs": 3000,
      "durationHintMs": 6800,
      "audioPath": "audio/narration/chapter_07_victory.ogg",
      "text": "Ar livre... Eu saí... Eu consegui sair! Espera... as travas externas abriram juntas... Meu Deus, o que eu deixei escapar pra neve?!"
    },
    {
      "id": "pickup_kit",
      "scope": "shared",
      "emotion": "calmo",
      "priority": 1,
      "exaggeration": 0.45,
      "cfgWeight": 0.55,
      "cooldownMs": 8000,
      "durationHintMs": 3400,
      "audioPath": "audio/narration/pickup_kit.ogg",
      "text": "Um Kit de Estanca... Graças a Deus. Melhor guardar isso pra quando a coisa apertar."
    },
    {
      "id": "pickup_badge",
      "scope": "shared",
      "emotion": "tenso",
      "priority": 2,
      "exaggeration": 0.6,
      "cfgWeight": 0.5,
      "cooldownMs": 8000,
      "durationHintMs": 3800,
      "audioPath": "audio/narration/pickup_badge.ogg",
      "text": "Achei o cartão de acesso... Preciso girar esse crachá no PADD pra ver se deixaram algum código anotado."
    },
    {
      "id": "inspect_badge_pin",
      "scope": "shared",
      "emotion": "tenso",
      "priority": 2,
      "exaggeration": 0.65,
      "cfgWeight": 0.48,
      "cooldownMs": 8000,
      "durationHintMs": 3800,
      "audioPath": "audio/narration/inspect_badge_pin.ogg",
      "text": "Aqui atrás... um código riscado à mão! Agora é só achar o painel e abrir a comporta."
    },
    {
      "id": "door_locked_no_power",
      "scope": "shared",
      "emotion": "tenso",
      "priority": 2,
      "exaggeration": 0.68,
      "cfgWeight": 0.46,
      "cooldownMs": 10000,
      "durationHintMs": 3800,
      "audioPath": "audio/narration/door_locked_no_power.ogg",
      "text": "Trancada e sem energia... Droga! Preciso religar os relés auxiliares antes de tentar o teclado."
    },
    {
      "id": "relay_short_circuit",
      "scope": "shared",
      "emotion": "panico",
      "priority": 4,
      "exaggeration": 0.9,
      "cfgWeight": 0.38,
      "cooldownMs": 5000,
      "durationHintMs": 3400,
      "audioPath": "audio/narration/relay_short_circuit.ogg",
      "text": "Agh! Curto-circuito! Essa linha vermelha vai me matar—ou chamar aquela coisa pra cá!"
    },
    {
      "id": "relay_solved",
      "scope": "shared",
      "emotion": "tenso",
      "priority": 3,
      "exaggeration": 0.72,
      "cfgWeight": 0.45,
      "cooldownMs": 6000,
      "durationHintMs": 3800,
      "audioPath": "audio/narration/relay_solved.ogg",
      "text": "Energia de volta... Isso! Agora o teclado da comporta deve responder."
    },
    {
      "id": "door_unlocked",
      "scope": "shared",
      "emotion": "ofegante",
      "priority": 4,
      "exaggeration": 0.82,
      "cfgWeight": 0.4,
      "cooldownMs": 5000,
      "durationHintMs": 3400,
      "audioPath": "audio/narration/door_unlocked.ogg",
      "text": "Abriu! A comporta tá abrindo... Vamos, Arthur, atravessa logo!"
    },
    {
      "id": "newborn_vent_drop",
      "scope": "shared",
      "emotion": "panico",
      "priority": 5,
      "exaggeration": 0.95,
      "cfgWeight": 0.35,
      "cooldownMs": 12000,
      "durationHintMs": 3800,
      "audioPath": "audio/narration/newborn_vent_drop.ogg",
      "text": "Não, não, não! Ele caiu do duto! Apaga a lanterna e sai daqui agora!"
    },
    {
      "id": "ambient_distress",
      "scope": "shared",
      "emotion": "medo",
      "priority": 1,
      "exaggeration": 0.64,
      "cfgWeight": 0.48,
      "cooldownMs": 28000,
      "durationHintMs": 3600,
      "audioPath": "audio/narration/ambient_distress.ogg",
      "text": "Que barulho foi esse nos dutos...? Isso não é o prédio cedendo..."
    },
    {
      "id": "newborn_investigate",
      "scope": "shared",
      "emotion": "medo",
      "priority": 3,
      "exaggeration": 0.78,
      "cfgWeight": 0.44,
      "cooldownMs": 16000,
      "durationHintMs": 3800,
      "audioPath": "audio/narration/newborn_investigate.ogg",
      "text": "Ele me ouviu... Tá vindo farejar por aqui. Silêncio... não faz nenhum som."
    },
    {
      "id": "newborn_hunt",
      "scope": "shared",
      "emotion": "panico",
      "priority": 5,
      "exaggeration": 0.98,
      "cfgWeight": 0.34,
      "cooldownMs": 12000,
      "durationHintMs": 3600,
      "audioPath": "audio/narration/newborn_hunt.ogg",
      "text": "Ele me viu! Corre, corre, corre! Acha um armário ou uma curva!"
    },
    {
      "id": "locker_enter",
      "scope": "shared",
      "emotion": "tenso",
      "priority": 2,
      "exaggeration": 0.7,
      "cfgWeight": 0.46,
      "cooldownMs": 10000,
      "durationHintMs": 3600,
      "audioPath": "audio/narration/locker_enter.ogg",
      "text": "Shhh... Fecha devagar. Segura a respiração até ele passar..."
    },
    {
      "id": "breath_low",
      "scope": "shared",
      "emotion": "ofegante",
      "priority": 4,
      "exaggeration": 0.88,
      "cfgWeight": 0.38,
      "cooldownMs": 11000,
      "durationHintMs": 3400,
      "audioPath": "audio/narration/breath_low.ogg",
      "text": "Argh... Não consigo mais segurar o fôlego... Meus pulmões tão queimando..."
    },
    {
      "id": "battery_low",
      "scope": "shared",
      "emotion": "tenso",
      "priority": 2,
      "exaggeration": 0.68,
      "cfgWeight": 0.46,
      "cooldownMs": 30000,
      "durationHintMs": 3600,
      "audioPath": "audio/narration/battery_low.ogg",
      "text": "A bateria da lanterna tá morrendo... Preciso girar o dínamo logo!"
    },
    {
      "id": "battery_empty",
      "scope": "shared",
      "emotion": "medo",
      "priority": 3,
      "exaggeration": 0.78,
      "cfgWeight": 0.44,
      "cooldownMs": 22000,
      "durationHintMs": 3600,
      "audioPath": "audio/narration/battery_empty.ogg",
      "text": "Apagou tudo... Não enxergo um palmo! Dínamo... gira esse dínamo!"
    },
    {
      "id": "player_hurt_red",
      "scope": "shared",
      "emotion": "panico",
      "priority": 5,
      "exaggeration": 0.96,
      "cfgWeight": 0.35,
      "cooldownMs": 6000,
      "durationHintMs": 4200,
      "audioPath": "audio/narration/player_hurt_red.ogg",
      "text": "Agh!! Meu braço... Tá sangrando muito! Se eu não estancar isso agora, ele vai sentir o cheiro!"
    },
    {
      "id": "player_healed",
      "scope": "shared",
      "emotion": "ofegante",
      "priority": 3,
      "exaggeration": 0.74,
      "cfgWeight": 0.45,
      "cooldownMs": 6000,
      "durationHintMs": 3800,
      "audioPath": "audio/narration/player_healed.ogg",
      "text": "Uff... O curativo segurou o sangue... Dói pra caramba, mas ainda tô vivo."
    },
    {
      "id": "gameover_defeat",
      "scope": "shared",
      "emotion": "panico",
      "priority": 5,
      "exaggeration": 0.96,
      "cfgWeight": 0.36,
      "cooldownMs": 3000,
      "durationHintMs": 4800,
      "audioPath": "audio/narration/gameover_defeat.ogg",
      "text": "N-não... Fica longe! Alguém... tira essa coisa de cima de mim—!"
    },
    {
      "id": "chapter_01_log_1",
      "scope": "chapter",
      "chapterId": 1,
      "emotion": "tenso",
      "priority": 3,
      "exaggeration": 0.65,
      "cfgWeight": 0.48,
      "cooldownMs": 2000,
      "durationHintMs": 5600,
      "audioPath": "audio/narration/chapter_01_log_1.ogg",
      "text": "Registro da Enfermeira Clara... Se alguém ainda estiver vivo, os cacos no corredor norte denunciam quem corre. Caminhe agachado sobre o vidro."
    },
    {
      "id": "chapter_01_log_2",
      "scope": "chapter",
      "chapterId": 1,
      "emotion": "tenso",
      "priority": 3,
      "exaggeration": 0.65,
      "cfgWeight": 0.48,
      "cooldownMs": 2000,
      "durationHintMs": 5800,
      "audioPath": "audio/narration/chapter_01_log_2.ogg",
      "text": "Nota do Paramédico Braga... Deixei uma isca sonora perto da sala de Raio-X. Se a trava central falhar, jogue o alarme pro outro lado e corra."
    },
    {
      "id": "chapter_02_log_1",
      "scope": "chapter",
      "chapterId": 2,
      "emotion": "medo",
      "priority": 3,
      "exaggeration": 0.72,
      "cfgWeight": 0.46,
      "cooldownMs": 2000,
      "durationHintMs": 5600,
      "audioPath": "audio/narration/chapter_02_log_1.ogg",
      "text": "Gravação Criogênica... Baixamos o nitrogênio do átrio para menos vinte, mas ele continuou caçando pelo som da água congelada."
    },
    {
      "id": "chapter_02_log_2",
      "scope": "chapter",
      "chapterId": 2,
      "emotion": "tenso",
      "priority": 3,
      "exaggeration": 0.68,
      "cfgWeight": 0.46,
      "cooldownMs": 2000,
      "durationHintMs": 5800,
      "audioPath": "audio/narration/chapter_02_log_2.ogg",
      "text": "Rádio Congelado na Passarela Leste... Se precisar ganhar tempo no átrio, puxe a comporta oeste no painel amarelo e dê a volta pelos fundos."
    },
    {
      "id": "chapter_03_log_1",
      "scope": "chapter",
      "chapterId": 3,
      "emotion": "medo",
      "priority": 3,
      "exaggeration": 0.75,
      "cfgWeight": 0.45,
      "cooldownMs": 2000,
      "durationHintMs": 5800,
      "audioPath": "audio/narration/chapter_03_log_1.ogg",
      "text": "Diário do Dormitório A... Escutamos ele arrastar algo pesado pelos beliches. Desligamos o aquecedor, mas o cheiro de sangue sempre o traz de volta."
    },
    {
      "id": "chapter_03_log_2",
      "scope": "chapter",
      "chapterId": 3,
      "emotion": "tenso",
      "priority": 3,
      "exaggeration": 0.68,
      "cfgWeight": 0.47,
      "cooldownMs": 2000,
      "durationHintMs": 5600,
      "audioPath": "audio/narration/chapter_03_log_2.ogg",
      "text": "Mensagem da Ala Leste... Se ficar encurralado entre os dormitórios, use as passagens laterais e feche a comporta central atrás de você."
    },
    {
      "id": "chapter_04_log_1",
      "scope": "chapter",
      "chapterId": 4,
      "emotion": "medo",
      "priority": 3,
      "exaggeration": 0.76,
      "cfgWeight": 0.45,
      "cooldownMs": 2000,
      "durationHintMs": 5800,
      "audioPath": "audio/narration/chapter_04_log_1.ogg",
      "text": "Nota de Campo da Doutora Elena... O vidro do tanque sudoeste rompeu por dentro. Os cacos espalhados são o pior perigo para quem tenta fugir correndo."
    },
    {
      "id": "chapter_04_log_2",
      "scope": "chapter",
      "chapterId": 4,
      "emotion": "tenso",
      "priority": 3,
      "exaggeration": 0.68,
      "cfgWeight": 0.46,
      "cooldownMs": 2000,
      "durationHintMs": 5800,
      "audioPath": "audio/narration/chapter_04_log_2.ogg",
      "text": "Relatório da Câmara Zero... Quando os relés caem, ele sobe pelos dutos por alguns segundos antes de retornar. Aproveite essas janelas para avançar."
    },
    {
      "id": "chapter_05_log_1",
      "scope": "chapter",
      "chapterId": 5,
      "emotion": "medo",
      "priority": 3,
      "exaggeration": 0.76,
      "cfgWeight": 0.44,
      "cooldownMs": 2000,
      "durationHintMs": 5800,
      "audioPath": "audio/narration/chapter_05_log_1.ogg",
      "text": "Caixa Preta do Engenheiro Torres... Se a lanterna começar a piscar forte do nada, não é bateria — ele está prestes a descer pelo duto acima de você."
    },
    {
      "id": "chapter_05_log_2",
      "scope": "chapter",
      "chapterId": 5,
      "emotion": "calmo",
      "priority": 3,
      "exaggeration": 0.52,
      "cfgWeight": 0.52,
      "cooldownMs": 2000,
      "durationHintMs": 5400,
      "audioPath": "audio/narration/chapter_05_log_2.ogg",
      "text": "Nota do Anel Oeste... O reator cria um anel completo. Use o pilar central para cortar a linha de visão e nunca fique sem fôlego."
    },
    {
      "id": "chapter_06_log_1",
      "scope": "chapter",
      "chapterId": 6,
      "emotion": "tenso",
      "priority": 3,
      "exaggeration": 0.7,
      "cfgWeight": 0.46,
      "cooldownMs": 2000,
      "durationHintMs": 5400,
      "audioPath": "audio/narration/chapter_06_log_1.ogg",
      "text": "Registro da Diretoria Ômega... Abrimos passagens nas pontas das chicanas para manutenção. Nunca fique preso num único corredor."
    },
    {
      "id": "chapter_06_log_2",
      "scope": "chapter",
      "chapterId": 6,
      "emotion": "medo",
      "priority": 3,
      "exaggeration": 0.78,
      "cfgWeight": 0.44,
      "cooldownMs": 2000,
      "durationHintMs": 5800,
      "audioPath": "audio/narration/chapter_06_log_2.ogg",
      "text": "Último Desabafo do Bloco Ômega... Quando você sangra, cada gota no chão vira um rastro até você. Use o Kit de Estanca antes de tentar hackear a porta."
    },
    {
      "id": "chapter_07_log_1",
      "scope": "chapter",
      "chapterId": 7,
      "emotion": "tenso",
      "priority": 3,
      "exaggeration": 0.74,
      "cfgWeight": 0.45,
      "cooldownMs": 2000,
      "durationHintMs": 5800,
      "audioPath": "audio/narration/chapter_07_log_1.ogg",
      "text": "Transmissão do Hangar Sul... A tempestade lá fora já tomou a pista. Se abrir o portão de carga, nada mais vai segurar o que está atrás de você."
    },
    {
      "id": "chapter_07_log_2",
      "scope": "chapter",
      "chapterId": 7,
      "emotion": "ofegante",
      "priority": 3,
      "exaggeration": 0.84,
      "cfgWeight": 0.42,
      "cooldownMs": 2000,
      "durationHintMs": 5600,
      "audioPath": "audio/narration/chapter_07_log_2.ogg",
      "text": "Caixa Preta, Última Ordem... Todo o complexo colapsou. Esta é sua última chance de sair vivo do Vanguard-7. Não olhe para trás."
    }
  ]
}
